# Fidelis Strategy — Hostinger shared hosting config
# Next.js static export with trailingSlash: true
# Each route is exported as /route/index.html

Options -MultiViews
RewriteEngine On
RewriteBase /

# -------------------------------------------------------
# Enforce HTTPS
# -------------------------------------------------------
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

# -------------------------------------------------------
# Enforce www (or drop www — pick one, not both)
# To enforce www: uncomment the www block, comment non-www
# -------------------------------------------------------

# Non-www (recommended for fidelisstrategy.net). www DNS and TLS SAN both
# cover apex + www; this 301 runs after a successful handshake.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Door is /brief/. Old audit URLs 301 (before trailing-slash rewrite).
RewriteRule ^growth-audit/?$ /brief/ [L,R=301]
RewriteRule ^growth-audit/checklist/?$ /brief/ [L,R=301]
RewriteRule ^growth-audit/checklist/pdf/?$ /brief/ [L,R=301]

# -------------------------------------------------------
# Enforce trailing slash (matches Next.js trailingSlash: true)
# -------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteRule ^(.*)$ /$1/ [L,R=301]

# -------------------------------------------------------
# Serve index.html for directory requests
# -------------------------------------------------------
DirectoryIndex index.html

# -------------------------------------------------------
# Security headers
# -------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# AVIF is served as text/plain on LiteSpeed without this; nosniff then blocks the image.
AddType image/avif .avif

Options -Indexes

# -------------------------------------------------------
# Cache static assets aggressively, HTML never
# -------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

# -------------------------------------------------------
# Gzip compression
# -------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# -------------------------------------------------------
# Custom 404
# -------------------------------------------------------
ErrorDocument 404 /404/index.html
